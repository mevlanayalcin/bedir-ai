{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "bedir-ai",
  "compatibility_date": "2026-10-06",
  "main": "build/worker.js",
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": "dist",
    "binding": "ASSETS",
    "not_found_handling": "404-page"
  }
}
