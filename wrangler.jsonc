{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "bedir-ai",
  "compatibility_date": "2026-10-06",
  "main": "build/worker.js",
  "durable_objects": {
    "bindings": [{ "name": "ASK_LIMIT", "class_name": "AskLimit" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["AskLimit"] }],
  "kv_namespaces": [{ "binding": "WAITLIST", "id": "64a65c721f1944bd864b290958390293" }],
  "custom_domains": ["bedirsavasi.com", "www.bedirsavasi.com"],
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": "dist",
    "binding": "ASSETS",
    "not_found_handling": "404-page"
  }
}
